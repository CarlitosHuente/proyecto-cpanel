# Copiar a .env y completar secretos ( .env no se sube a git )

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=huente_app

# Puerto Flask en hosting (opcional; default 10000)
# PORT=10000

# Buk — RRHH (Configuración → Accesos API)
BUK_TENANT=huentelauquen
BUK_AUTH_TOKEN=

# Buk Asistencia — marcajes (token distinto al RRHH)
# Swagger: https://app.swaggerhub.com/apis-docs/BUKASISTENCIA/ApiAsistencia/1.0.0
# Soporte: https://supportcenter.buk.cl/hc/es-419/articles/50240904785051-APIs-de-Buk-Asistencia
BUK_ASISTENCIA_TOKEN=
# BUK_ASISTENCIA_API_BASE=https://app.ctrlit.cl/ctrl/api

# Encuestas → carpeta en ficha Buk (default Capacitacion)
# BUK_ENCUESTA_CARPETA=Capacitacion

# Notificación de firma tras subir PDF (default true)
# BUK_INICIAR_FLUJO_AUTOMATICO=true
# BUK_NOTIFICAR_TRAS_SUBIDA=true
# BUK_PORTAL_URL=https://huentelauquen.buk.cl

# Respaldo correo si Buk no expone API «Notificar» (opcional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=huente@huentelauquen.cl
# SMTP_USE_TLS=true
# BUK_AVISO_FIRMA_ASUNTO=Documento pendiente de firma — Huente

# IMAP — bandeja PDF (Arqueo / resúmenes). HostChile Secure SSL.
# IMAP_HOST=mail.datoshuente.com
# IMAP_PORT=993
# IMAP_USER=admin@datoshuente.com
# IMAP_PASSWORD=Carvajal.21
# IMAP_FOLDER=INBOX
# IMAP_SSL=true
# Token para cron: POST /arqueo-caja/correo-pdf/sync-token (header X-Mail-Sync-Token)
# MAIL_SYNC_TOKEN=

# Opcional
# BUK_API_BASE=https://huentelauquen.buk.cl/api/v1/chile
# BUK_COUNTRY=chile
